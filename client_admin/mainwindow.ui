  <property name="styleSheet">
   <string>
QMainWindow,QWidget#centralwidget{background:#0B1326;color:#DCE6F7;font-family:"Noto Sans CJK SC","Microsoft YaHei","PingFang SC",sans-serif;}
QFrame#sidebar{background:#111A2B;border-right:1px solid #2B3B4A;}
QFrame#sidebarBrand{background:#222A3D;border:1px solid #3C4A45;border-radius:14px;}
QLabel#brandIcon{background:#10B981;color:#053728;border-radius:11px;font-size:26px;font-weight:900;}
QLabel#brandName{color:#E4ECF8;font-size:24px;font-weight:900;}
QLabel#brandSub{color:#81928A;font-size:16px;}
QLabel#adminMiniBadge{background:#103127;color:#54D9A7;border:1px solid #205E4B;border-radius:8px;padding:5px 7px;font-size:12px;font-weight:800;}
QLabel#navSectionLabel{color:#6D7F89;font-size:12px;font-weight:900;}
QPushButton#navRevenueButton,QPushButton#navChargerStatusButton,QPushButton#navChargerManageButton,QPushButton#navStationManageButton,QPushButton#navUserManageButton,QPushButton#navPredictionButton{text-align:left;background:transparent;color:#9EADB6;border:none;border-radius:9px;padding:0 16px;font-size:17px;font-weight:750;}
QPushButton#navRevenueButton:hover,QPushButton#navChargerStatusButton:hover,QPushButton#navChargerManageButton:hover,QPushButton#navStationManageButton:hover,QPushButton#navUserManageButton:hover,QPushButton#navPredictionButton:hover{background:#1B2A3A;color:#E2ECF2;}
QPushButton#navRevenueButton:checked,QPushButton#navChargerStatusButton:checked,QPushButton#navChargerManageButton:checked,QPushButton#navStationManageButton:checked,QPushButton#navUserManageButton:checked,QPushButton#navPredictionButton:checked{background:#17372F;color:#54D9A7;border-left:3px solid #10B981;}
QFrame#mainPanel{background:#0B1326;}
QFrame#toolbar{background:#111B2C;border:1px solid #2C3D4C;border-radius:12px;}
QLabel#pageTitleLabel{color:#E7EEF8;font-size:29px;font-weight:900;}
QLabel#pageSubtitleLabel{color:#7C8E99;font-size:14px;}
QLabel#currentAdminLabel{color:#54D9A7;font-size:14px;font-weight:800;}
QLabel#clockLabel{color:#AEBAC2;font-size:14px;}
QPushButton#refreshButton,QPushButton#logoutButton{background:#172739;color:#CAD6DE;border:1px solid #364B5B;border-radius:9px;padding:0 20px;font-size:14px;font-weight:800;}
QPushButton#refreshButton:hover{background:#1D3447;border-color:#4C6676;}
QPushButton#logoutButton:hover{background:#31262B;border-color:#6B4D55;color:#FFB0B0;}
QFrame#statusStrip{background:#101A2A;border:1px solid #293B49;border-radius:9px;}
QLabel#databaseStatusLabel,QLabel#databasePathLabel,QLabel#onlineChargerLabel,QLabel#lastRefreshLabel,QLabel#adminStatusLabel{color:#81929D;font-size:12px;}
QLabel#onlineChargerLabel{color:#54D9A7;font-weight:800;}
QFrame#metricCard1,QFrame#metricCard2,QFrame#metricCard3{background:#172236;border:1px solid #2B3E4E;border-radius:12px;}
QLabel#metricTitle1,QLabel#metricTitle2,QLabel#metricTitle3{color:#8294A0;font-size:14px;font-weight:700;}
QLabel#metricValue1,QLabel#metricValue2,QLabel#metricValue3{color:#E4ECF7;font-size:36px;font-weight:900;}
QLabel#metricAccent1,QLabel#metricAccent2,QLabel#metricAccent3{color:#54D9A7;font-size:12px;font-weight:800;}
QFrame#chartCard{background:#121D30;border:1px solid #293D4D;border-radius:12px;}
QLabel#chartTitle,QLabel#orderChartTitle{color:#DEE8F2;font-size:18px;font-weight:850;}
QLabel#chartDescription,QLabel#queryPerformanceLabel{color:#748692;font-size:12px;}
QLabel#pageIcon{color:#54D9A7;font-size:40px;font-weight:900;}
QLabel#pagePlaceholderTitle{color:#DEE8F2;font-size:22px;font-weight:900;}
QLabel#pagePlaceholderText{color:#748692;font-size:13px;}
QPushButton#period7Button,QPushButton#period30Button{background:#172739;color:#AFC0CA;border:1px solid #364B5B;border-radius:9px;padding:0 16px;font-size:13px;font-weight:850;}
QPushButton#period7Button:hover,QPushButton#period30Button:hover{background:#1C3445;border-color:#4D6575;}
QPushButton#period7Button:checked,QPushButton#period30Button:checked{background:#17372F;color:#54D9A7;border:1px solid #2B6C57;}
QFrame#orderChartCard{background:#121D30;border:1px solid #293D4D;border-radius:12px;}
QStatusBar{background:#08111E;color:#61717C;border-top:1px solid #1E2D39;}
</string>

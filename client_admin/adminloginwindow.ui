}
QWidget#centralwidget {
    background: transparent;
}
QLabel {
    color: #A79BD1;
    font-family: &quot;Noto Sans CJK SC&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, sans-serif;
}
QLabel#brandMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #A855F7, stop:0.55 #EC4899, stop:1 #F97316);
    color: #1A0B2E;
    border: 1px solid #C084FC;
    border-radius: 23px;
    font-size: 22px;
    font-weight: 900;
}
QLabel#brandName {
    color: #FBF7FF;
    font-size: 20px;
    font-weight: 900;
}
QLabel#brandCaption {
    color: #8B7DB8;
    font-size: 10px;
    font-weight: 700;

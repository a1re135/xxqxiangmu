        stop:0 #211640, stop:1 #150C2C);
    border: 1px solid #3D2C68;
    border-radius: 22px;
}
QLineEdit {
    background-color: #170F2E;
    color: #F7F2FF;
    border: 1px solid #3A2C63;
    border-radius: 12px;
    padding: 0px 14px;
    selection-background-color: #9333EA;
    selection-color: #FFFFFF;
    font-size: 14px;
}
QLineEdit:hover {
    border-color: #5B3FA0;
}
QLineEdit:focus {
    background-color: #1C1238;
    border: 2px solid #C084FC;
    padding: 0px 13px;
}
QLineEdit:disabled {
    color: #5C4E85;
    background-color: #180F2C;
}
QLineEdit::placeholder {
    color: #6E5F98;
}
QPushButton {
    background-color: #201640;
    color: #E9E1FF;
    border: 1px solid #40316E;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 800;
    padding: 0px 12px;
}
QPushButton:hover {
    background-color: #2C1E54;
    border-color: #5B3FA0;
}
QPushButton:pressed {
    background-color: #170F2E;
}
QPushButton:disabled {
    background-color: #180F2C;
    color: #5C4E85;
    border-color: #241A44;
}
QPushButton#togglePasswordButton {
    background: transparent;
    border: none;
    color: #76669F;
    font-size: 10px;
}
QPushButton#togglePasswordButton:hover {
    color: #D9B7FF;
}
QPushButton#loginButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8B5CF6, stop:0.55 #EC4899, stop:1 #F97316);
    color: #1A0B2E;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.5px;
}
QPushButton#loginButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #A47BFA, stop:0.55 #F472B6, stop:1 #FB923C);
}
QPushButton#loginButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7C3AED, stop:0.55 #DB2777, stop:1 #EA580C);
}
QLabel#passwordHintLabel {
    color: #776A9E;
    font-size: 10px;
}
QLabel#statusLabel {
    color: #8577AD;
    font-size: 12px;
    font-weight: 700;
}
QLabel#statusLabel[error=&quot;true&quot;] {
    color: #FB7185;
}
QLabel#statusLabel[error=&quot;false&quot;] {
    color: #34D9A8;
}
QLabel#lockoutLabel {
    color: #E7A65C;
    font-size: 11px;
    font-weight: 700;
}
QLabel#securityNote {

  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #0B1326;
}
QWidget#centralwidget {
    background-color: #0B1326;
    color: #DCE6F7;
}

QFrame#heroPanel {
    background-color: #0B1326;
    border: none;
}

QFrame#adminPanel {
    background-color: #101A2D;
    border: none;
}

QFrame#brandCard {
    background-color: #222A3D;
    border: 1px solid #3B4A45;
    border-radius: 16px;
}

QFrame#brandIconBox {
    background-color: #10B981;
    border: 1px solid #52DFA6;
    border-radius: 13px;
}

QLabel {
    font-family: &quot;Noto Sans CJK SC&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, sans-serif;
}

QLabel#brandIcon {
    color: #043728;
    font-size: 24px;
    font-weight: 900;
}

QLabel#brandName {
    color: #DCE6F7;
    font-size: 20px;
    font-weight: 850;
}

QLabel#brandBadge {
    background-color: #103743;
    color: #54D9F2;
    border: 1px solid #226073;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#versionBadge {
    background-color: #12372D;
    color: #52DFA6;
    border: 1px solid #245D4A;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#brandCaption {
    color: #B7C7C0;
    font-size: 10px;
}

QLabel#adminBadge {
    background-color: #0F3028;
    color: #52DFA6;
    border: 1px solid #21604C;
    border-radius: 9px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#welcomeBolt {
    color: #43DFA9;
    font-size: 22px;
    font-weight: 900;
}

QLabel#heroHeadline {
    color: #E7EEF9;
    font-size: 31px;
    font-weight: 900;
}

QLabel#heroSubtext {
    color: #A7B7C1;
    font-size: 13px;
}

QLabel#heroHint {
    color: #667986;
    font-size: 10px;
}

QFrame#featureCard {
    background-color: #141F31;
    border: 1px solid #273B49;
    border-radius: 12px;
}

QLabel#featureIcon1,
QLabel#featureIcon2,
QLabel#featureIcon3 {
    color: #4ADFB0;
    font-size: 15px;
    font-weight: 900;
}

QLabel#featureTitle1,
QLabel#featureTitle2,
QLabel#featureTitle3 {
    color: #DDE7EF;
    font-size: 10px;
    font-weight: 800;
}

QLabel#featureText1,
QLabel#featureText2,
QLabel#featureText3 {
    color: #70838F;
    font-size: 9px;
}

QLabel#footerLabel {
    color: #536873;
    font-size: 9px;
}

QFrame#loginCard {
    background-color: #182238;
    border: 1px solid #324256;
    border-radius: 16px;
}

QLabel#loginSectionIcon {
    color: #50E0AD;
    font-size: 16px;
    font-weight: 900;
}

QLabel#loginSectionTitle {
    color: #E7EEF9;
    font-size: 15px;
    font-weight: 850;
}

QLabel#securityBadge {
    background-color: #103127;
    color: #4FE0AB;
    border: 1px solid #22614B;
    border-radius: 9px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#loginSub {
    color: #9DAEBA;
    font-size: 10px;
}

QLabel#fieldLabelUsername,
QLabel#fieldLabelPassword {
    color: #B9C8D0;
    font-size: 10px;
    font-weight: 800;
}

QLabel#fieldHint {
    color: #70828C;
    font-size: 9px;
}

QFrame#usernameInputFrame,
QFrame#passwordInputFrame {
    background-color: #081221;
    border: 1px solid #34495A;
    border-radius: 9px;
}

QFrame#usernameInputFrame:focus-within,
QFrame#passwordInputFrame:focus-within {
    border: 1px solid #10B981;
}

QLabel#usernameInputIcon,
QLabel#passwordInputIcon {
    color: #738690;
    font-size: 12px;
    font-weight: 800;
}

QLineEdit#usernameLineEdit,
QLineEdit#passwordLineEdit {
    background-color: transparent;
    border: none;
    color: #E7EEF9;
    padding: 0px 2px;
    font-size: 12px;
}

QLineEdit#usernameLineEdit::placeholder,
QLineEdit#passwordLineEdit::placeholder {
    color: #5F7280;
}

QPushButton#clearUsernameButton {
    background: transparent;
    border: none;
    color: #71818B;
    font-size: 13px;
}

QPushButton#clearUsernameButton:hover {
    color: #DDE7EF;
}

QPushButton#togglePasswordButton {
    background-color: #111C2D;
    border: 1px solid #3A4D5D;
    border-radius: 9px;
    color: #58DDAF;
    font-size: 9px;
    font-weight: 800;
}

QPushButton#togglePasswordButton:hover {
    background-color: #142B27;
    border-color: #50E0AD;
}

QLabel#passwordHintLabel {
    color: #6D7F8A;
    font-size: 9px;
}

QLabel#statusLabel {
    color: #738691;
    font-size: 10px;
    font-weight: 700;
}

QLabel#statusLabel[error=&quot;true&quot;] {
    color: #FF8D86;
}

QLabel#statusLabel[error=&quot;false&quot;] {
    color: #4FE0AB;
}

QLabel#lockoutLabel {
    color: #E7B267;
    font-size: 9px;
    font-weight: 800;
}

QPushButton#loginButton {
    background-color: #10B981;
    color: #031B12;
    border: none;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 900;
}

QPushButton#loginButton:hover {
    background-color: #1BD398;
}

QPushButton#loginButton:pressed {
    background-color: #0A9A6A;
}

QPushButton#loginButton:disabled {
    background-color: #155A45;
    color: #718B83;
}

QFrame#securityNoticeFrame {
    background-color: #121D2E;
    border: 1px solid #244558;
    border-radius: 8px;
}

QLabel#securityIcon {
    color: #55D9F2;
    font-size: 10px;
    font-weight: 900;
}

QLabel#securityNoticeLabel {
    color: #8DA1AD;
    font-size: 9px;
}

QLabel#attemptBadge {
    background-color: #103127;
    color: #4FE0AB;
    border: 1px solid #21604C;
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 8px;
    font-weight: 900;
}

QLabel#securityNote {
    color: #5C717D;
    font-size: 8px;
}

QStatusBar {
    background-color: #08111F;
    color: #4E616D;
    border-top: 1px solid #172A38;
}
   

/* Enlarged admin-login typography and controls */
QLabel#loginSectionTitle {
    font-size: 18px;
}
QLabel#loginSub {
    font-size: 12px;
}
QLabel#fieldLabelUsername,
QLabel#fieldLabelPassword {
    font-size: 12px;
}
QLabel#fieldHint {
    font-size: 10px;
}
QLineEdit#usernameLineEdit,
QLineEdit#passwordLineEdit {
    font-size: 14px;
}
QLabel#passwordHintLabel {
    font-size: 10px;
}
QLabel#statusLabel {
    font-size: 11px;
}
QLabel#lockoutLabel {
    font-size: 10px;
}
QPushButton#togglePasswordButton {
    font-size: 10px;
}
QPushButton#loginButton {
    font-size: 15px;
}
QLabel#securityNoticeLabel {
    font-size: 10px;
}
QLabel#securityNote {
    font-size: 9px;
}
QLabel#attemptBadge {
    font-size: 9px;
}


/* Global scale-up pass: make the desktop version feel substantial
   while retaining the same client_user visual identity. */
QLabel#brandIcon {
    font-size: 29px;
}
QLabel#brandName {
    font-size: 23px;
}

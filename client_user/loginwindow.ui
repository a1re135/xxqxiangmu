}

QLabel#statusLabel {
    color: #70869D;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 0px;
}

QLabel#statusLabel[error="true"] {
    color: #FF7F90;
}

QLabel#statusLabel[error="false"] {
    color: #55E0A8;
}

QLabel#tipLabel {
    color: #5F738A;
    font-size: 11px;
    line-height: 150%;
}

QLineEdit {
    background-color: #0D1B2B;
    color: #F5F9FD;
    border: 1px solid #1B344A;
    border-radius: 12px;
    padding: 0px 14px;
    selection-background-color: #1D8FB8;
    selection-color: #FFFFFF;
    font-size: 14px;
}

QLineEdit:hover {
    border-color: #2A506C;
}

QLineEdit:focus {
    background-color: #0E2032;
    border: 1px solid #2EC9F5;
}

QLineEdit::placeholder {
    color: #587088;
}

QPushButton {
    background-color: #11263A;
    color: #DDEAF5;
    border: 1px solid #23445D;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    padding: 0px 12px;
}

QPushButton:hover {
    background-color: #17344C;
    border-color: #2F607F;
}

QPushButton:pressed {
    background-color: #0D2031;
}

QPushButton:disabled {
    background-color: #0D1927;
    color: #52687D;
    border-color: #15293B;
}

QPushButton#loginButton {
    background-color: #18B9E8;
    color: #04101A;
    border: none;
    border-radius: 13px;
    font-size: 15px;
    font-weight: 800;
}

QPushButton#loginButton:hover {
    background-color: #35C9F1;
}

QPushButton#loginButton:pressed {
    background-color: #12A2CC;
}

QFrame#loginCard {
    background-color: #0A1727;
    border: 1px solid #152D43;

  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #0B1326;
    color: #DAE2FD;
}

QFrame#brandCard {
    background-color: #222A3D;
    border: 1px solid #3C4A42;
    border-radius: 14px;
}

QFrame#brandIconBox {
    background-color: #10B981;
    border: 1px solid #4EDEA3;
    border-radius: 12px;
}

QLabel#brandIcon {
    color: #003824;
    font-size: 26px;
    font-weight: 900;
}

QLabel#brandName {
    color: #DAE2FD;
    font-size: 19px;
    font-weight: 800;
}

QLabel#brandBadge {
    background-color: #103744;
    color: #4CD7F6;
    border: 1px solid #206071;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 700;
}

QLabel#versionBadge {
    background-color: #12372D;
    color: #4EDEA3;
    border: 1px solid #255B49;
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 9px;
    font-weight: 700;
}

QLabel#brandCaption {
    color: #BBCABF;
    font-size: 11px;
}

QFrame#loginCard {
    background-color: #171F33;
    border: 1px solid #2D3A45;
    border-radius: 14px;
}

QLabel#headline {
    color: #DAE2FD;
    font-size: 18px;
    font-weight: 800;
}

QLabel#welcomeEnglish {
    color: #4EDEA3;
    font-size: 11px;
    font-weight: 700;
}

QLabel#subheadline, QLabel#hintLabel {
    color: #BBCABF;
    font-size: 11px;
}

QLabel#boltAccent {
    color: #4EDEA3;
    font-size: 22px;
    font-weight: 900;
}

QLabel#loginSectionIcon {
    color: #4EDEA3;
    font-size: 17px;
    font-weight: 900;
}

QLabel#loginSectionTitle {
    color: #DAE2FD;
    font-size: 14px;
    font-weight: 750;
}

QLabel#passwordlessBadge {
    background-color: #113A31;
    color: #4EDEA3;
    border: 1px solid #246151;
    border-radius: 10px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#fieldLabelPhone, QLabel#fieldLabelCode {
    color: #BBCABF;
    font-size: 11px;
    font-weight: 650;
}

QLabel#fieldHintPhone {
    color: #86948A;
    font-size: 10px;
}

QLabel#fieldHintCode {
    color: #4EDEA3;
    font-size: 10px;
}

QFrame#phoneInputFrame, QFrame#codeInputFrame {
    background-color: #060E20;
    border: 1px solid #3C4A42;
    border-radius: 9px;
}

QFrame#phoneInputFrame[focused=&quot;true&quot;], QFrame#codeInputFrame[focused=&quot;true&quot;] {
    border: 1px solid #4EDEA3;
}

QLabel#countryCode {
    color: #4CD7F6;
    font-size: 12px;
    font-weight: 750;
}

QLabel#countryArrow {
    color: #86948A;
    font-size: 10px;
}

QFrame#countryDivider {
    background-color: #2D3449;
    min-width: 1px;
    max-width: 1px;
}

QLabel#keyIcon {
    color: #86948A;
    font-size: 14px;
}

QLineEdit#phoneLineEdit, QLineEdit#verificationCodeLineEdit {
    background-color: transparent;
    color: #DAE2FD;
    border: none;
    padding: 0px 4px;
    font-size: 13px;
    selection-background-color: #10B981;
    selection-color: #003824;
}

QLineEdit#verificationCodeLineEdit {
    letter-spacing: 2px;
}

QLineEdit#phoneLineEdit:focus, QLineEdit#verificationCodeLineEdit:focus {
    border: none;
    outline: none;
}

QPushButton#clearPhoneButton {
    background: transparent;
    border: none;
    color: #86948A;
    font-size: 16px;
    padding: 0px;
}

QPushButton#clearPhoneButton:hover {
    color: #DAE2FD;
}

QPushButton#getCodeButton {
    background-color: #222A3D;
    color: #4EDEA3;
    border: 1px solid #2F6B57;
    border-radius: 9px;
    padding: 0px 10px;
    font-size: 11px;
    font-weight: 750;
}

QPushButton#getCodeButton:hover {
    background-color: #183A32;
    border-color: #4EDEA3;
}

QPushButton#getCodeButton:pressed {
    background-color: #123128;
}

QPushButton#getCodeButton:disabled {
    background-color: #1A2434;
    color: #64748B;
    border-color: #334155;
}

QFrame#mockNoticeFrame {
    background-color: #131B2E;
    border: 1px solid #24566A;
    border-radius: 8px;
}

QLabel#mockIcon, QLabel#mockNoticeLabel {
    color: #4CD7F6;
    font-size: 10px;
    font-weight: 650;
}

QLabel#mockPassBadge {
    background-color: #12372D;
    color: #4EDEA3;
    border: 1px solid #255B49;
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 9px;
    font-weight: 800;
}

QLabel#verificationInfoLabel {
    color: #4EDEA3;
    font-size: 11px;
    font-weight: 750;
}

QLabel#countdownLabel {
    color: #86948A;
    font-size: 10px;
}

QCheckBox#userAgreementCheckBox {
    color: #BBCABF;
    font-size: 10px;
    spacing: 7px;
}

QCheckBox#userAgreementCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid #4EDEA3;
    background-color: #060E20;
}

QCheckBox#userAgreementCheckBox::indicator:checked {
    background-color: #4EDEA3;
    border: 1px solid #4EDEA3;
}

QLabel#agreementLinksLabel {
    color: #4CD7F6;
    font-size: 10px;
}

QLabel#statusLabel {
    color: #86948A;
    font-size: 10px;
    font-weight: 650;
}

QLabel#statusLabel[error=&quot;true&quot;] {
    color: #FF8D86;
}

QLabel#statusLabel[error=&quot;false&quot;] {
    color: #4EDEA3;
}

QPushButton#loginButton {
    background-color: #10B981;
    color: #002113;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 850;
}

QPushButton#loginButton:hover {
    background-color: #4EDEA3;
}

QPushButton#loginButton:pressed {
    background-color: #059669;
}

QLabel#footerIcon {
    color: #68DBA9;
    font-size: 12px;
}

QLabel#footerLabel {
    color: #86948A;
    font-size: 10px;
}
</string>
